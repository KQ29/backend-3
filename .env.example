# Local application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8001
STREAMLIT_API_URL=http://127.0.0.1:8001
STREAMLIT_PORT=8502
BACKEND_API_TOKEN=

# Browser-facing client timeout budgets
STREAMLIT_API_TIMEOUT_SECONDS=120
STREAMLIT_VOICE_TIMEOUT_SECONDS=210

# Interview controls
NUDGE_AFTER_HOURS=10
ABANDON_AFTER_HOURS=24
INACTIVITY_CHECK_SECONDS=3600
MAX_SUBSTANTIVE_TURNS=16
MAX_PROBES_PER_ANCHOR=2

# Persistence. Keep these defaults for a local, non-persistent demo.
INTERVIEW_REPOSITORY=memory
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alias, if the project has not migrated to an sb_secret_ key:
SUPABASE_SERVICE_ROLE_KEY=

# NVIDIA NIM / OpenAI-compatible moderation
LLM_ENABLED=false
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=meta/llama-3.1-70b-instruct
LLM_MODE=always
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CALLS_PER_SESSION=16
LLM_LOW_CONFIDENCE_THRESHOLD=0.70
LLM_MAX_OUTPUT_TOKENS=512

# Speechmatics Batch transcription. Use STT_PROVIDER=speechmatics when enabled.
STT_PROVIDER=mock
SPEECHMATICS_API_KEY=
STT_BASE_URL=https://asr.api.speechmatics.com/v2
STT_MODEL=
STT_LANGUAGE=auto
STT_TIMEOUT_SECONDS=60
STT_MAX_AUDIO_BYTES=20971520

# Optional future operational endpoint protection
ADMIN_API_TOKEN=
